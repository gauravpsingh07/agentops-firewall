# ---------------------------------------------------------------------------
# Backend (.env.example) — placeholder values only. Copy to .env locally.
# All real secrets must be supplied via the environment, not committed.
# ---------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=local

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentops
SPRING_DATASOURCE_USERNAME=agentops
SPRING_DATASOURCE_PASSWORD=local_dev_only

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topic names (defaults below match docs/architecture.md)
AGENTOPS_KAFKA_TOPIC_ACTIONS_RECEIVED=agent.actions.received
AGENTOPS_KAFKA_TOPIC_ACTIONS_DECIDED=agent.actions.decided
AGENTOPS_KAFKA_TOPIC_ACTIONS_COMPLETED=agent.actions.completed

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=agentops
SPRING_RABBITMQ_PASSWORD=local_dev_only

# RabbitMQ queue names
AGENTOPS_RABBITMQ_QUEUE_APPROVAL_REQUESTS=approval.requests
AGENTOPS_RABBITMQ_QUEUE_APPROVAL_NOTIFICATIONS=approval.notifications

# JWT — replace JWT_SECRET with a >=32-byte random string in any non-trivial env.
JWT_SECRET=CHANGE_ME_use_a_long_random_value_in_real_environments
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=agentops-firewall

# Demo seed users — LOCAL DEVELOPMENT ONLY. Never use in production.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_REVIEWER_USERNAME=reviewer
DEMO_REVIEWER_PASSWORD=reviewer123
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer123
