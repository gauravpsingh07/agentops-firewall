# ---------------------------------------------------------------------------
# AgentOps Firewall — root .env.example
# Copy this file to .env (which is git-ignored) and fill in local values.
# DO NOT put real secrets here. Use placeholders only.
# ---------------------------------------------------------------------------

# Postgres (used by docker-compose)
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=local_dev_only

# RabbitMQ (used by docker-compose)
RABBITMQ_DEFAULT_USER=agentops
RABBITMQ_DEFAULT_PASS=local_dev_only

# Backend (Spring Boot)
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MINUTES=60

# Demo seed users — LOCAL DEVELOPMENT ONLY.
# These are intentional placeholders for evaluators running the demo.
# Never replicate this pattern in production.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_REVIEWER_USERNAME=reviewer
DEMO_REVIEWER_PASSWORD=reviewer123
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer123
